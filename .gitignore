# ===========================================================
# MastiSense — .gitignore
# ===========================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment / secrets ---
.env

# ESP32 credentials — NEVER commit.
# Commit hardware/secrets_example.h instead.
secrets.h
hardware/secrets.h

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Database (regenerated at runtime) ---
*.db

# --- Generated synthetic datasets ---
# Regenerate with:  python generate_data.py
# Deterministic (seed 2026), so identical output every time.
# Excluded because the CSVs are ~23 MB combined.
data/*.csv

# --- Model artifacts ---
# Candidate versions are regenerated by training.
models/v*/
# NOTE: models/current/ is intentionally NOT ignored so that a
# fresh clone can serve predictions immediately without a full
# retrain. If you prefer a lean repo, add "models/current/" here
# and document that users must run train_model.py first.

# --- OS ---
.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/

# --- Test / coverage ---
.pytest_cache/
htmlcov/
.coverage