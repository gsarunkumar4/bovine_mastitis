# MastiSense — Environment Variables (copy to .env and fill in)
#
# All values have sensible defaults; set only what you need to override.
# The .env file is git-ignored and must never contain production secrets
# in a shared repo.

# Database path (default: mastitis.db in project root)
# MASTISENSE_DB=./mastitis.db

# Model artifact directory (default: ./models)
# MASTISENSE_MODELS=./models

# API server
# MASTISENSE_HOST=127.0.0.1
# MASTISENSE_PORT=8000

# CORS allowed origins (comma-separated; default: * for prototype)
# MASTISENSE_CORS=http://localhost:3000,http://127.0.0.1:8000
